generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id         String   @id @default(uuid())
  name       String
  driveLink  String
  pin        String   @unique
  maxPhotos  Int      @default(20)
  waNumber   String   @default("")
  createdAt  DateTime @default(now())
}
